OPENAI_API_KEY=your_openai_api_key_here

# Yael — read-only access to all tables in the Airtable base (see .claude/skills/airtable-read/SKILL.md for the table list)
# Dani — same key/base, but scoped usage: read-only for internal-link lookups, plus create-only writes
# to the existing-content table when an article goes live (see .claude/skills/airtable-write/SKILL.md).
# The token itself needs both data.records:read and data.records:write scopes for Dani's write step to work.
AIRTABLE_API_KEY=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Roi — weekly plan email (see .claude/skills/email-send/SKILL.md)
RESEND_API_KEY=your_resend_api_key_here
PLAN_EMAIL_TO=your_email_here

# Dani — optional, Core Web Vitals section of seo-technical-audit (see .claude/skills/seo-technical-audit/SKILL.md)
PAGESPEED_API_KEY=your_pagespeed_insights_api_key_here

# Dani — optional, real Search Console data for seo-content-refresh + seo-technical-audit
# (see .claude/skills/google-search-console/SKILL.md for the one-time service-account setup)
GOOGLE_SEARCH_CONSOLE_KEY_FILE=credentials/gsc-service-account.json
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:your-domain.com
